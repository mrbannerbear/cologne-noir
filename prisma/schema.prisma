generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum VariantSize {
  DECANT_5ML
  DECANT_10ML
  DECANT_100ML
  FULL_BOTTLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Product {
  id                       String          @id @default(cuid())
  slug                     String          @unique
  brand                    String
  name                     String
  concentration            String?
  gender                   Gender
  description              String?         @db.Text
  topNotes                 String[]
  middleNotes              String[]
  baseNotes                String[]
  actualBottleMl           Int
  images                   String[]
  isAvailable              Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  variants                 ProductVariant[]
  orderItems               OrderItem[]

  @@index([isAvailable])
  @@index([gender])
}

model ProductVariant {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       VariantSize
  priceBdt   Int
  stockQty   Int          @default(0)
  sku        String?      @unique
  orderItems OrderItem[]

  @@index([productId])
  @@unique([productId, size])
}

model Order {
  id           String       @id @default(cuid())
  orderNumber  String       @unique
  customerName String
  phone        String
  address      String       @db.Text
  city         String
  notes        String?      @db.Text
  environment  String       @default("production")
  status       OrderStatus  @default(PENDING)
  totalBdt     Int
  offerId      String?
  offer        Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([offerId])
}

model OfferEvent {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  offers      Offer[]

  @@index([isActive])
}

model Offer {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  tagline       String
  occasion      String?
  description   String?     @db.Text
  productSlugs  String[]
  price5mlBdt   Int
  price10mlBdt  Int
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  eventId       String
  event         OfferEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orders        Order[]

  @@index([eventId, isActive])
}

model OrderItem {
  id                   String          @id @default(cuid())
  orderId              String
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String
  product              Product         @relation(fields: [productId], references: [id])
  productVariantId     String?
  productVariant       ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  label                String
  quantity             Int
  unitPriceBdtAtOrder  Int
  totalPriceBdtAtOrder Int

  @@index([orderId])
}
